{
  "name": "rate-repository-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "cross-env ENV=test expo start",
    "build": "cross-env ENV=production expo build",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "cross-env ENV=test expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "lint": "eslint ./src/**/*.{js,jsx} App.js --no-error-on-unmatched-pattern"
  },
  "jest": {
    "preset": "jest-expo",
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|@sentry/.*|react-router-native)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setupTests.js"
    ]
  },
  "dependencies": {
    "@apollo/client": "^3.12.1",
    "@apollo/react-hooks": "^4.0.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@testing-library/react": "^16.0.1",
    "apollo-boost": "^0.4.9",
    "date-fns": "^4.1.0",
    "dotenv": "^11.0.0",
    "expo": "^52.0.14",
    "expo-constants": "^17.0.3",
    "expo-linking": "^7.0.3",
    "expo-status-bar": "~2.0.0",
    "formik": "^2.4.6",
    "graphql": "^15.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.3",
    "react-native-paper": "^5.12.5",
    "react-native-web": "~0.19.13",
    "react-router-dom": "^6.28.0",
    "react-router-native": "^6.28.0",
    "react-test-renderer": "^18.0.0",
    "use-debounce": "^10.0.4",
    "yup": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "babel-eslint": "^10.1.0",
    "babel-preset-expo": "~12.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-react": "^7.37.2",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.2"
  },
  "private": true
}
